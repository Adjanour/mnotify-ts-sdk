{
  "name": "mnotify-ts-sdk",
  "version": "3.0.0",
  "description": "Modern, zero-dependency TypeScript SDK for mNotify BMS API - SMS, contacts, and account management with Railway-Oriented Programming",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "mnotify",
    "africa",
    "ghana",
    "bms",
    "sdk",
    "api",
    "sms",
    "messaging",
    "bulk-sms",
    "typescript",
    "zero-dependencies",
    "contacts",
    "templates"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adjanour/mnotify-ts-sdk.git"
  },
  "author": "Adjanour adjanour@icloud.com",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "biome check src/ test/",
    "format": "biome format --write src/ test/",
    "docs:api": "typedoc --options typedoc.docs.json",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.10",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.4.6",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.11.0",
    "typedoc-plugin-missing-exports": "^4.1.3",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  }
}
